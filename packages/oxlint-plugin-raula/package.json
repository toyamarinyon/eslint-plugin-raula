{
	"name": "oxlint-plugin-raula",
	"version": "0.0.1",
	"description": "Opinionated oxlint rules and a shareable config preset for JSX/module.css Next.js app standards.",
	"keywords": [
		"oxlint",
		"oxlint-plugin",
		"nextjs",
		"tailwindcss",
		"design-system"
	],
	"homepage": "https://github.com/toyamarinyon/raula/tree/main/packages/oxlint-plugin-raula",
	"bugs": {
		"url": "https://github.com/toyamarinyon/raula/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toyamarinyon/raula.git",
		"directory": "packages/oxlint-plugin-raula"
	},
	"type": "module",
	"exports": {
		".": "./index.mjs",
		"./.oxlintrc.json": "./.oxlintrc.json"
	},
	"files": [
		"index.mjs",
		"rules",
		".oxlintrc.json",
		"REFERENCE.md",
		"references"
	],
	"sideEffects": false,
	"scripts": {
		"generate-reference": "bun run scripts/generate-reference.ts",
		"build": "bun run generate-reference",
		"prepublishOnly": "bun run build",
		"test": "bun test tests"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"oxlint": ">=1.43.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "20.19.39",
		"oxlint": "1.75.0"
	}
}
