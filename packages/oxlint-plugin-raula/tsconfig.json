{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node", "bun"],
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["scripts/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules"]
}
